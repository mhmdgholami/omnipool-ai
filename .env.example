APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=./data/omnipool.db
SCAN_ON_STARTUP=true

AI_PRIMARY_PROVIDER=ollama
AI_ALLOW_PAID_PROVIDERS=false
AI_ENABLE_OLLAMA=true
AI_ENABLE_GROQ=true
AI_ENABLE_OPENROUTER=true

OLLAMA_BASE_URL=http://127.0.0.1:11434
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

AI_FAST_MODEL=qwen3:1.7b
AI_GENERAL_MODEL=qwen3:4b
AI_REASONING_MODEL=qwen3:4b
AI_CODING_MODEL=qwen2.5-coder:3b
AI_EMBEDDING_MODEL=nomic-embed-text
AI_TIMEOUT_SECONDS=20
AI_HEALTH_TTL_SECONDS=20
AI_MAX_RETRIES=1
AI_MAX_CONCURRENCY=2
AI_QUEUE_TIMEOUT_SECONDS=5
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=900

DEXSCREENER_BASE_URL=https://api.dexscreener.com
X_BEARER_TOKEN=
X_QUERY=(meme OR viral OR trending OR launch) -is:retweet lang:en
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=omnipool-ai/0.4

SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet

MAX_TRENDS=100
MAX_OBSERVATIONS_PER_SCAN=240
CACHE_TTL_SECONDS=30
MARKET_CACHE_SIZE=64
MARKET_CACHE_TTL_SECONDS=120
REQUEST_TIMEOUT_SECONDS=8
MAX_REQUEST_BYTES=65536
RATE_LIMIT_PER_MINUTE=120
MAX_RATE_LIMIT_CLIENTS=2000
ENABLE_DEMO_SEEDS=true
