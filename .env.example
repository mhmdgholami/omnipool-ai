APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=/data/omnipool.db

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

DEXSCREENER_BASE_URL=https://api.dexscreener.com
X_BEARER_TOKEN=
X_QUERY=(meme OR viral OR trending OR launch) -is:retweet lang:en
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=omnipool-ai/0.3

SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet

MAX_TRENDS=100
MAX_OBSERVATIONS_PER_SCAN=240
CACHE_TTL_SECONDS=30
MARKET_CACHE_SIZE=64
MARKET_CACHE_TTL_SECONDS=120
REQUEST_TIMEOUT_SECONDS=8
MAX_REQUEST_BYTES=65536
RATE_LIMIT_PER_MINUTE=120
MAX_RATE_LIMIT_CLIENTS=2000
ENABLE_DEMO_SEEDS=true
